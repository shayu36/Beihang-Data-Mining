# Default: XeLaTeX; the original pdfLaTeX font mappings are also retained.
$pdf_mode = 5;
$xelatex = 'xelatex -no-shell-escape %O %S';
$pdflatex = 'pdflatex -no-shell-escape %O %S';
my $pathsep = $^O eq 'MSWin32' ? ';' : ':';
$ENV{TEXINPUTS} = join($pathsep, '.', './styles', './fonts', (defined $ENV{TEXINPUTS} ? $ENV{TEXINPUTS} : ''));
$ENV{BIBINPUTS} = join($pathsep, '.', './bib', (defined $ENV{BIBINPUTS} ? $ENV{BIBINPUTS} : ''));
$ENV{BSTINPUTS} = join($pathsep, '.', './bib', (defined $ENV{BSTINPUTS} ? $ENV{BSTINPUTS} : ''));
$ENV{TFMFONTS} = join($pathsep, '.', './fonts', (defined $ENV{TFMFONTS} ? $ENV{TFMFONTS} : ''));
$ENV{VFFONTS} = join($pathsep, '.', './fonts', (defined $ENV{VFFONTS} ? $ENV{VFFONTS} : ''));
