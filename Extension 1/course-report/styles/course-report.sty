% standard TeX ligatures. No font conversion is performed during compilation.
\DeclareFontFamily{T1}{reporttimes}{}
\DeclareFontShape{T1}{reporttimes}{m}{n}{<-> rpttimesr}{}
\DeclareFontShape{T1}{reporttimes}{b}{n}{<-> rpttimesb}{}
\DeclareFontShape{T1}{reporttimes}{m}{it}{<-> rpttimesi}{}
\DeclareFontShape{T1}{reporttimes}{b}{it}{<-> rpttimesbi}{}
\DeclareFontShape{T1}{reporttimes}{m}{sl}{<-> ssub * reporttimes/m/it}{}
\DeclareFontShape{T1}{reporttimes}{b}{sl}{<-> ssub * reporttimes/b/it}{}
\DeclareFontShape{T1}{reporttimes}{m}{sc}{<-> rpttimesrsc}{}
\DeclareFontShape{T1}{reporttimes}{b}{sc}{<-> rpttimesbsc}{}
\DeclareFontShape{T1}{reporttimes}{bx}{n}{<-> ssub * reporttimes/b/n}{}
\DeclareFontShape{T1}{reporttimes}{bx}{it}{<-> ssub * reporttimes/b/it}{}
\DeclareFontShape{T1}{reporttimes}{bx}{sl}{<-> ssub * reporttimes/b/sl}{}
\DeclareFontShape{T1}{reporttimes}{bx}{sc}{<-> ssub * reporttimes/b/sc}{}
\renewcommand{\rmdefault}{reporttimes}
\renewcommand{\sfdefault}{reporttimes}

\renewcommand{\CJKrmdefault}{reportsong}
\renewcommand{\CJKsfdefault}{reporthei}
\renewcommand{\CJKttdefault}{reportsong}
\renewcommand{\songti}{\CJKfamily{reportsong}}
\renewcommand{\heiti}{\CJKfamily{reporthei}}
\renewcommand{\kaishu}{\CJKfamily{reportkai}}
\normalfont

  \RequirePackage{bm}
  \newcommand{\vect}[1]{\bm{#1}}
  \newcommand{\tensor}[1]{\bm{#1}}
\else
  % The same bundled fonts are loaded directly by XeLaTeX / Tectonic.
  \setmainfont{times.ttf}[Path=fonts/,BoldFont=timesbd.ttf,
    ItalicFont=timesi.ttf,BoldItalicFont=timesbi.ttf]
  \setsansfont{times.ttf}[Path=fonts/,BoldFont=timesbd.ttf,
    ItalicFont=timesi.ttf,BoldItalicFont=timesbi.ttf]
  \setCJKmainfont{Simsun.ttc}[Path=fonts/,FontIndex=0,
    AutoFakeBold=2,ItalicFont=Kaiti.ttf]
  \setCJKsansfont{SimHei.ttf}[Path=fonts/,BoldFont=SimHei.ttf]
  \setCJKmonofont{Simsun.ttc}[Path=fonts/,FontIndex=0]
  \setCJKfamilyfont{reportsong}{Simsun.ttc}[Path=fonts/,FontIndex=0,
    AutoFakeBold=2,ItalicFont=Kaiti.ttf]
  \setCJKfamilyfont{reporthei}{SimHei.ttf}[Path=fonts/,BoldFont=SimHei.ttf]
  \setCJKfamilyfont{reportkai}{Kaiti.ttf}[Path=fonts/]
  \renewcommand{\songti}{\CJKfamily{reportsong}}
  \renewcommand{\heiti}{\CJKfamily{reporthei}}
  \renewcommand{\kaishu}{\CJKfamily{reportkai}}
  \newcommand{\vect}[1]{\symbf{#1}}
  \newcommand{\tensor}[1]{\symbf{#1}}
\fi

\settopmatter{printacmref=false,printccs=false,printfolios=true}
\setcopyright{none}
\emergencystretch=2em
\AtEndPreamble{\hypersetup{pdflang={zh-CN}}}
\AtBeginDocument{%
  \hypersetup{linkcolor=black,citecolor=black,urlcolor=blue}%
  \renewcommand{\refname}{参考文献}%
  \renewcommand{\abstractname}{摘要}%
  \renewcommand{\figurename}{图}%
  \renewcommand{\tablename}{表}%
  \renewcommand{\proofname}{证明}%
}

\makeatletter
% Extra separation below the full-width author block (adjustable).
\newlength{\ReportAuthorBottomSpace}
\setlength{\ReportAuthorBottomSpace}{8mm}
\apptocmd{\@mkauthors@iii}{%
  \global\setbox\mktitle@bx=\vbox{%
    \unvbox\mktitle@bx\vskip\ReportAuthorBottomSpace}%
}{}{\PackageError{course-report}{Cannot adjust author spacing}{Check acmart version.}}
% Identical centered running header on the first and subsequent pages.
\newcommand{\ReportRunningHeader}{数据挖掘导论课程报告2026年}
\newcommand{\report@pagestyle}{%
  \fancyhf{}%
  \renewcommand{\headrulewidth}{0pt}%
  \renewcommand{\footrulewidth}{0pt}%
  \fancyhead[C]{\rmfamily\songti\zihao{-5}\ReportRunningHeader}%
  \fancyfoot[C]{\rmfamily\footnotesize\thepage}%
}
\AtBeginDocument{%
  \fancypagestyle{standardpagestyle}{\report@pagestyle}%
  \fancypagestyle{firstpagestyle}{\report@pagestyle}%
  \pagestyle{standardpagestyle}%
}
% 五号 = 10.5 bp. Preserve the class's other normal-size settings.
\let\report@originalnormalsize\normalsize
\renewcommand{\normalsize}{%
  \report@originalnormalsize\fontsize{10.5bp}{13.5bp}\selectfont}
\normalsize
% Font hooks, rather than redefinitions of acmart's sectioning commands.
\def\@titlefont{\rmfamily\songti\zihao{3}\bfseries}
\def\@authorfont{\rmfamily\songti\zihao{4}\mdseries}
\def\@affiliationfont{\rmfamily\songti\zihao{-5}\mdseries}
\def\@secfont{\rmfamily\heiti\zihao{-4}\mdseries\section@raggedright}
\def\@subsecfont{\rmfamily\heiti\zihao{5}\mdseries\section@raggedright}
\def\@subsubsecfont{\rmfamily\heiti\zihao{5}\mdseries}
% Abstracts occupy the same first-column position as in acmart.
% The Chinese abstract and keywords are 五号楷体; English is 五号 Times.
\def\@mkabstract{\begingroup
  \ifx\@abstract\@lempty\else
    \kaishu\zihao{5}\noindent\textbf{摘要}\quad
    \ignorespaces\@abstract\par
  \fi
\endgroup}
\makeatother

% Keep figure captions below figures, table captions above tables, and the
% class's caption alignment/separator. Apply only the Word font sizes.
\DeclareCaptionFont{reportsmall}{\rmfamily\songti\zihao{-5}}
\DeclareCaptionFont{reporttabletitle}{\rmfamily\heiti\zihao{-5}}
\captionsetup[figure]{font={reportsmall,md},labelfont=md,textfont=md}
\captionsetup[table]{font=reporttabletitle}
\AtBeginEnvironment{tabular}{\rmfamily\zihao{-5}}
\renewcommand{\bibliofont}{\rmfamily\songti\fontsize{7.5bp}{10bp}\selectfont}

% Use acmart's theorem styles with Chinese names.
\theoremstyle{acmdefinition}
\newtheorem{reportdefinition}{定义}
\theoremstyle{acmplain}
\newtheorem{reporttheorem}{定理}

